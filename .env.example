# Copia este archivo a .env.local y completa los valores (no subas .env.local a git).

# Recuperación de contraseña (Resend) — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=Deseo Libre <onboarding@resend.dev>
APP_BASE_URL=http://localhost:3000

