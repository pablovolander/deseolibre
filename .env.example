# Copia este archivo a .env.local y completa los valores (no subes .env.local a git).

# Recuperación de contraseña (Resend) — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=Deseo Libre <onboarding@resend.dev>
APP_BASE_URL=http://localhost:3000

# Opcional en local (hay valor por defecto en desarrollo)
# JWT_SECRET=tu_secreto_local

# Base de datos Turso (recomendado en producción — plan free)
# https://turso.tech — la BD ya no se guarda en Vercel Blob
# TURSO_DATABASE_URL=libsql://tu-db-nombre-usuario.turso.io
# TURSO_AUTH_TOKEN=tu_token_de_turso

# Vercel Blob — solo fotos/vídeos (no la base de datos si usas Turso)
# BLOB_READ_WRITE_TOKEN=

# Monitoramento opcional
# SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# Solo producción / Vercel
# ADMIN_BOOTSTRAP_SECRET=
